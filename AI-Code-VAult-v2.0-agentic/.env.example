# AI Code Vault 2.0 Environment Variables

# GROQ API Key for Llama 3.3-70B Model Integration
GROQ_API_KEY=your_groq_api_key_here


# Optional model overrides for the agentic AI layer
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Default Admin Provisioning Credentials (Used to automatically seed the admin account on startup)
ADMIN_EMAIL=admin@codevault.local
ADMIN_PASSWORD=AdminPass123!
